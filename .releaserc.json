{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "VERSION_NAME=${nextRelease.version} ./gradlew --no-daemon assembleDebug && cp app/build/outputs/apk/debug/app-debug.apk loaloaloa.apk"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "loaloaloa.apk", "name": "loaloaloa.apk", "label": "Loa Loa Loa ${nextRelease.version} — Android APK (sideload)" }
        ]
      }
    ]
  ]
}
