<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background layer: the Loa Loa Loa brand teal gradient
  (#0EA5A4 → #0E7490), matching /tmp/logo_full.png and logo.svg. The
  foreground (mipmap/ic_launcher_foreground) is the white megaphone-₫
  mark on its own teal square, so the composited adaptive icon reads as
  a solid teal tile with the white megaphone regardless of mask shape.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#0EA5A4"
        android:endColor="#0E7490"
        android:angle="315" />
</shape>
